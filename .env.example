# ─────────────────────────────────────────────────────────────────────────────
# DOM GUIMA — variáveis de ambiente
# Copie para `.env.local` e preencha. NUNCA versione o .env.local.
# ─────────────────────────────────────────────────────────────────────────────

# Domínio final do site (usado em canonical, sitemap, Open Graph e JSON-LD).
NEXT_PUBLIC_SITE_URL=https://www.domguima.com.br

# WhatsApp da loja — só dígitos, com código do país e DDD.
# Número confirmado pelo lojista em 20/08/2026.
NEXT_PUBLIC_WHATSAPP_NUMBER=553498748425

# Link opcional para sobrescrever o perfil público do Google já configurado.
# As métricas são um retrato manual datado; nenhuma API do Google é necessária.
NEXT_PUBLIC_GOOGLE_PROFILE_URL=

# ─── Instagram (opcional) ───────────────────────────────────────────────────
# Token de longa duração da conta business + ID da conta.
# Sem estes, a seção do Instagram mostra o convite para seguir.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=

# ─── Painel administrativo (conta unica) ─────────────────────────────────────
# Gere localmente com `npm run setup:admin`. Na Vercel, cadastre os tres valores
# gerados como variaveis protegidas do projeto.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# Criado automaticamente ao conectar um Vercel Blob publico ao projeto.
BLOB_READ_WRITE_TOKEN=

# ─── Supabase (OBRIGATÓRIO em produção) ─────────────────────────────────────
# Sem estas duas, o painel LÊ o catálogo mas não consegue SALVAR nada em
# produção — qualquer alteração falha com "Configure o Supabase para salvar
# alteracoes em producao.". Localmente, sem elas, os dados vão para
# data/admin-catalog.json.
# Ambas são somente de servidor. NUNCA use o prefixo NEXT_PUBLIC_ nelas: a
# chave secreta ignora as políticas de RLS e dá acesso total ao banco.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# ─── Assistente de cadastro com pesquisa na web (opcional) ──────────────────
# Chave somente no servidor. Nunca use NEXT_PUBLIC_ neste valor.
# Sem ela, o cadastro continua funcionando e o assistente informa que precisa
# ser configurado; nada é preenchido automaticamente sem revisão.
OPENAI_API_KEY=
# Opcional. Se vazio, usa o modelo padrão configurado pela aplicação.
OPENAI_PRODUCT_RESEARCH_MODEL=
